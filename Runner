class DiscordAPIHandler:
    def __init__(self):
        self.base_url = "https://discord.com/api/v9"
        self.session = requests.Session()
        self.session.headers.update({
            "Accept": "*/*",
            "Accept-Language": "en-US,en;q=0.9",
            "Accept-Encoding": "gzip, deflate, br",
            "Content-Type": "application/json",
            "Origin": "https://discord.com",
            "Referer": "https://discord.com/",
            "Sec-Fetch-Dest": "empty",
            "Sec-Fetch-Mode": "cors",
            "Sec-Fetch-Site": "same-origin"
        })
    
    def get_headers(self, account: Dict[str, Any] = None) -> Dict[str, str]:
        headers = {
            "User-Agent": account.get("user_agent", random.choice(USER_AGENTS)) if account else random.choice(USER_AGENTS),
            "X-Super-Properties": account.get("super_properties", "") if account else "",
            "X-Discord-Locale": "en-US",
            "X-Debug-Options": "bugReporterEnabled"
        }
        if account and account.get("token"):
            headers["Authorization"] = account["token"]
        return headers
    
    def resolve_invite(self, invite_code: str) -> Optional[Dict[str, Any]]:
        url = f"{self.base_url}/invites/{invite_code}?with_counts=true&with_expiration=true"
        
        try:
            response = self.session.get(url, timeout=15)
            if response.status_code == 200:
                data = response.json()
                invite_info = {
                    "code": invite_code,
                    "guild_id": data.get("guild", {}).get("id"),
                    "channel_id": data.get("channel", {}).get("id"),
                    "channel_name": data.get("channel", {}).get("name"),
                    "guild_name": data.get("guild", {}).get("name"),
                    "guild_description": data.get("guild", {}).get("description"),
                    "guild_features": data.get("guild", {}).get("features", []),
                    "approximate_member_count": data.get("approximate_member_count"),
                    "approximate_presence_count": data.get("approximate_presence_count"),
                    "expires_at": data.get("expires_at"),
                    "inviter": data.get("inviter", {}).get("username") if data.get("inviter") else None,
                    "is_verified": data.get("guild", {}).get("verification_level", 0) > 1,
                    "nsfw": data.get("nsfw", False),
                    "flags": data.get("flags", 0),
                    "max_age": data.get("max_age"),
                    "max_uses": data.get("max_uses"),
                    "temporary": data.get("temporary", False)
                }
                logger.info(f"Resolved invite {invite_code} -> Guild: {invite_info['guild_name']} ({invite_info['guild_id']})")
                return invite_info
            elif response.status_code == 404:
                logger.error(f"Invite {invite_code} not found or expired")
            elif response.status_code == 429:
                logger.warning(f"Rate limited while resolving invite {invite_code}")
                retry_after = response.headers.get("Retry-After", "5")
                time.sleep(float(retry_after))
            else:
                logger.error(f"Failed to resolve invite {invite_code}: HTTP {response.status_code}")
        except Exception as e:
            logger.error(f"Error resolving invite {invite_code}: {e}")
        
        return None
    
    def extract_invite_code(self, input_str: str) -> Optional[str]:
        patterns = [
            r'(?:discord\.gg|discord\.com\/invite|discordapp\.com\/invite)\/([a-zA-Z0-9\-_]+)',
            r'^([a-zA-Z0-9\-_]+)$'
        ]
        for pattern in patterns:
            match = re.search(pattern, input_str)
            if match:
                return match.group(1)
        return None
    
    def is_guild_id(self, input_str: str) -> bool:
        return bool(re.match(r'^\d{17,20}$', input_str))
    
    def register_account(self, account: Dict[str, Any]) -> bool:
        url = f"{self.base_url}/auth/register"
        headers = self.get_headers(account)
        
        payload = {
            "username": account["username"],
            "password": account["password"],
            "email": account["email"],
            "date_of_birth": account["birth_date"],
            "consent": True,
            "fingerprint": account.get("fingerprint", ""),
            "captcha_key": None,
            "gift_code_sku_id": None,
            "invite": None
        }
        
        try:
            response = self.session.post(url, headers=headers, json=payload, timeout=15)
            
            if response.status_code in [200, 201]:
                data = response.json()
                account["token"] = data.get("token")
                account["user_id"] = data.get("user_id") or data.get("id")
                account["status"] = "registered"
                account["is_verified"] = False
                logger.info(f"Account {account['username']} registered successfully")
                return True
            elif response.status_code == 400:
                error_data = response.json()
                error_msg = error_data.get("message", "Bad request")
                if "captcha" in str(error_msg).lower():
                    account["status"] = "captcha_required"
                    logger.warning(f"Captcha required for {account['username']}")
                else:
                    account["status"] = "registration_failed"
                    account["last_join_error"] = error_msg
                    logger.error(f"Registration failed for {account['username']}: {error_msg}")
            elif response.status_code == 429:
                account["status"] = "rate_limited"
                retry_after = response.headers.get("Retry-After", "5")
                logger.warning(f"Rate limited registering {account['username']}, retry after {retry_after}s")
                time.sleep(float(retry_after))
            else:
                account["status"] = "registration_failed"
                logger.error(f"Registration failed: HTTP {response.status_code}")
        except Exception as e:
            account["status"] = "error"
            account["last_join_error"] = str(e)
            logger.error(f"Error registering {account['username']}: {e}")
        
        return False
    
    def join_guild(self, account: Dict[str, Any], invite_code: str) -> bool:
        url = f"{self.base_url}/invites/{invite_code}"
        headers = self.get_headers(account)
        
        payload = {
            "session_id": account.get("session_id", str(uuid.uuid4()))
        }
        
        try:
            response = self.session.post(url, headers=headers, json=payload, timeout=15)
            
            if response.status_code == 200:
                data = response.json()
                account["status"] = "joined"
                account["guild_id"] = data.get("guild", {}).get("id")
                account["guild_name"] = data.get("guild", {}).get("name")
                account["joined_at"] = datetime.now().isoformat()
                logger.info(f"{account['username']} joined {account.get('guild_name', invite_code)}")
                return True
            elif response.status_code == 400:
                error_data = response.json()
                error_msg = error_data.get("message", "Bad request")
                error_code = error_data.get("code", 0)
                
                if error_code == 40002 or "unauthorized" in str(error_msg).lower():
                    account["status"] = "invalid_token"
                elif error_code == 40007:
                    account["status"] = "banned"
                elif error_code == 40003:
                    account["status"] = "guild_full"
                elif "captcha" in str(error_msg).lower():
                    account["status"] = "captcha_required"
                elif "verification" in str(error_msg).lower():
                    account["status"] = "verification_required"
                else:
                    account["status"] = "join_failed"
                account["last_join_error"] = error_msg
            elif response.status_code == 403:
                account["status"] = "forbidden"
            elif response.status_code == 404:
                account["status"] = "invite_expired"
            elif response.status_code == 429:
                account["status"] = "rate_limited"
                retry_after = response.headers.get("Retry-After", "5")
                logger.warning(f"{account['username']}: Rate limited, retry after {retry_after}s")
                time.sleep(float(retry_after))
            else:
                account["status"] = "join_failed"
                logger.error(f"{account['username']}: HTTP {response.status_code}")
        except Exception as e:
            account["status"] = "error"
            account["last_join_error"] = str(e)
            logger.error(f"Error joining {account['username']}: {e}")
        
        return False
    
    def verify_token(self, account: Dict[str, Any]) -> bool:
        url = f"{self.base_url}/users/@me"
        headers = self.get_headers(account)
        
        try:
            response = self.session.get(url, headers=headers, timeout=15)
            if response.status_code == 200:
                data = response.json()
                account["user_id"] = data.get("id")
                account["username"] = data.get("username", account["username"])
                account["discriminator"] = data.get("discriminator", "0")
                account["is_verified"] = data.get("verified", False)
                account["status"] = "verified"
                return True
            elif response.status_code == 401:
                account["status"] = "invalid_token"
        except Exception as e:
            account["status"] = "error"
            account["last_join_error"] = str(e)
        
        return False
    
    def accept_rules_screening(self, account: Dict[str, Any], guild_id: str) -> bool:
        url = f"{self.base_url}/guilds/{guild_id}/member-verification"
        headers = self.get_headers(account)
        
        payload = {
            "version": "1.0",
            "form_fields": [],
            "version_hash": None
        }
        
        try:
            response = self.session.get(url, headers=headers, timeout=15)
            if response.status_code == 200:
                data = response.json()
                payload["version_hash"] = data.get("version_hash")
                payload["form_fields"] = data.get("form_fields", [])
            
            put_response = self.session.put(url, headers=headers, json=payload, timeout=15)
            if put_response.status_code in [200, 204]:
                return True
        except Exception as e:
            logger.error(f"Error accepting rules screening: {e}")
        
        return False

class JobManager:
    def __init__(self):
        self.jobs: Dict[str, JoinJob] = {}
        self.job_lock = threading.Lock()
        self.executor = ThreadPoolExecutor(max_workers=5)
        self.api_handler = DiscordAPIHandler()
        self.account_generator = AccountGenerator()
    
    def create_job(self, target: str, npc_count: int) -> JoinJob:
        job_id = str(uuid.uuid4())[:12]
        
        invite_code = self.api_handler.extract_invite_code(target)
        if invite_code:
            target_type = "invite"
        elif self.api_handler.is_guild_id(target):
            target_type = "guild_id"
        else:
            target_type = "unknown"
        
        job = JoinJob(
            job_id=job_id,
            target=target,
            target_type=target_type,
            npc_count=npc_count
        )
        
        with self.job_lock:
            self.jobs[job_id] = job
        
        job.add_log(f"Job created with target: {target}, NPC count: {npc_count}")
        logger.info(f"Created job {job_id} for {target} with {npc_count} NPCs")
        
        return job
    
    def get_job(self, job_id: str) -> Optional[JoinJob]:
        return self.jobs.get(job_id)
    
    def get_all_jobs(self) -> List[Dict[str, Any]]:
        return [job.to_dict() for job in self.jobs.values()]
    
    def cancel_job(self, job_id: str) -> bool:
        job = self.jobs.get(job_id)
        if job and job.status == JobStatus.RUNNING.value:
            job.cancel_requested = True
            job.add_log("Cancellation requested")
            return True
        return False
    
    def run_job(self, job: JoinJob):
        job.status = JobStatus.RUNNING.value
        job.started_at = datetime.now().isoformat()
        job.add_log("Job started")
        
        try:
            invite_code = None
            guild_info = None
            
            if job.target_type == "invite":
                invite_code = self.api_handler.extract_invite_code(job.target)
                if invite_code:
                    guild_info = self.api_handler.resolve_invite(invite_code)
                    if guild_info:
                        job.invite_code = invite_code
                        job.guild_id = guild_info.get("guild_id")
                        job.guild_name = guild_info.get("guild_name")
                        job.add_log(f"Resolved guild: {guild_info.get('guild_name')} ({guild_info.get('guild_id')})")
            elif job.target_type == "guild_id":
                job.guild_id = job.target
                job.add_log(f"Target guild ID: {job.target}")
                invite_code = job.target
            else:
                job.add_log("Invalid target format")
                job.status = JobStatus.FAILED.value
                job.completed_at = datetime.now().isoformat()
                return
            
            job.add_log(f"Generating {job.npc_count} NPC accounts...")
            accounts = self.account_generator.generate_batch(job.npc_count)
            job.accounts = accounts
            
            job.add_log("Registering accounts...")
            registered_accounts = []
            
            for i, account in enumerate(accounts):
                if job.cancel_requested:
                    job.add_log("Job cancelled during registration")
                    job.status = JobStatus.CANCELLED.value
                    job.completed_at = datetime.now().isoformat()
                    return
                
                success = self.api_handler.register_account(account)
                if success:
                    registered_accounts.append(account)
                    job.add_log(f"Registered {account['username']} ({i+1}/{len(accounts)})")
                else:
                    status = account.get("status", "unknown")
                    if status == "captcha_required":
                        job.total_captcha += 1
                    job.add_log(f"Failed to register {account['username']}: {status}")
                
                time.sleep(random.uniform(0.5, 1.5))
            
            job.add_log(f"Registered {len(registered_accounts)}/{len(accounts)} accounts")
            
            if not registered_accounts:
                job.add_log("No accounts registered successfully")
                job.status = JobStatus.COMPLETED.value
                job.completed_at = datetime.now().isoformat()
                return
            
            job.add_log(f"Starting join process for {len(registered_accounts)} accounts...")
            
            for i, account in enumerate(registered_accounts):
                if job.cancel_requested:
                    job.add_log("Job cancelled during joining")
                    job.status = JobStatus.CANCELLED.value
                    job.completed_at = datetime.now().isoformat()
                    return
                
                job.total_attempted += 1
                account["join_attempts"] += 1
                
                delay = random.uniform(1.0, 3.0)
                time.sleep(delay)
                
                if not account.get("token"):
                    job.total_failed += 1
                    job.add_log(f"{account['username']}: No token available")
                    continue
                
                success = self.api_handler.join_guild(account, invite_code)
                
                if success:
                    job.total_success += 1
                    job.add_log(f"{account['username']} joined successfully ({i+1}/{len(registered_accounts)})")
                    
                    guild_id = account.get("guild_id")
                    if guild_id:
                        time.sleep(random.uniform(0.5, 2.0))
                        self.api_handler.accept_rules_screening(account, guild_id)
                else:
                    job.total_failed += 1
                    status = account.get("status", "unknown")
                    if status == "rate_limited":
                        job.total_rate_limited += 1
                    elif status == "captcha_required":
                        job.total_captcha += 1
                    job.add_log(f"{account['username']} failed: {status} ({i+1}/{len(registered_accounts)})")
            
            job.add_log("Join process completed")
            job.status = JobStatus.COMPLETED.value
            job.completed_at = datetime.now().isoformat()
            job.add_log(f"Summary: {job.total_success} success, {job.total_failed} failed, {job.total_rate_limited} rate limited, {job.total_captcha} captcha")
            
        except Exception as e:
            job.status = JobStatus.FAILED.value
            job.completed_at = datetime.now().isoformat()
            job.add_log(f"Job failed with error: {e}")
            logger.error(f"Job {job.job_id} failed: {e}")
    
    def start_job_async(self, job: JoinJob):
        future = self.executor.submit(self.run_job, job)
        return future


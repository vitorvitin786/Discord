<body>
    <div class="container">
        <div class="header">
            <h1>⚡ DISCORD NPC JOINER</h1>
            <p>Automated Guest Account Joiner - Web Dashboard</p>
        </div>
        
        <div id="alertContainer"></div>
        
        <div class="card">
            <div class="card-title">
                <span class="icon">🚀</span>
                Create Join Job
            </div>
            
            <form id="joinForm" onsubmit="createJob(event)">
                <div class="form-group">
                    <label for="targetInput">Discord Server Link or Invite Code</label>
                    <input type="text" id="targetInput" placeholder="https://discord.gg/example or example-code" required>
                </div>
                
                <div class="form-group">
                    <label for="npcCount">Number of NPCs to Join</label>
                    <input type="number" id="npcCount" min="1" max="100" value="5" required>
                </div>
                
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    🎯 Start Joining
                </button>
            </form>
        </div>
        
        <div class="card">
            <div class="card-title">
                <span class="icon">📊</span>
                Active Jobs
                <button class="btn btn-sm btn-primary" onclick="refreshJobs()" style="margin-left: auto;">
                    🔄 Refresh
                </button>
            </div>
            
            <div id="jobsContainer" class="jobs-container">
                <div class="empty-state">
                    <div class="emoji">📭</div>
                    <p>No active jobs. Create your first job above!</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="modal-overlay" id="logModal">
        <div class="modal">
            <h3>📋 Job Logs</h3>
            <div id="modalLogs" class="job-logs" style="max-height: 400px; margin-bottom: 20px;"></div>
            <button class="btn btn-primary" onclick="closeLogModal()">Close</button>
        </div>
    </div>
    
    <div class="footer">
        <p>Discord NPC Joiner v2.0 | Web Dashboard</p>
    </div>
    
    <script>
        let jobsPollingInterval = null;
        let currentJobs = {};
        
        function showAlert(message, type) {
            const container = document.getElementById('alertContainer');
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type}`;
            alertDiv.textContent = message;
            container.appendChild(alertDiv);
            
            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }
        
        async function createJob(event) {
            event.preventDefault();
            
            const target = document.getElementById('targetInput').value.trim();
            const npcCount = parseInt(document.getElementById('npcCount').value);
            const submitBtn = document.getElementById('submitBtn');
            
            if (!target) {
                showAlert('Please enter a Discord server link or invite code', 'error');
                return;
            }
            
            if (npcCount < 1 || npcCount > 100) {
                showAlert('NPC count must be between 1 and 100', 'error');
                return;
            }
            
            submitBtn.disabled = true;
            submitBtn.textContent = '⏳ Creating...';
            
            try {
                const response = await fetch('/api/jobs', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        target: target,
                        npc_count: npcCount
                    })
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    showAlert(`Job created successfully! Job ID: ${data.job_id}`, 'success');
                    document.getElementById('targetInput').value = '';
                    document.getElementById('npcCount').value = '5';
                    refreshJobs();
                    startPolling();
                } else {
                    showAlert(data.error || 'Failed to create job', 'error');
                }
            } catch (error) {
                showAlert('Network error: ' + error.message, 'error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = '🎯 Start Joining';
            }
        }
        
        async function refreshJobs() {
            try {
                const response = await fetch('/api/jobs');
                const data = await response.json();
                
                if (response.ok) {
                    renderJobs(data.jobs);
                }
            } catch (error) {
                console.error('Failed to refresh jobs:', error);
            }
        }
        
        function renderJobs(jobs) {
            const container = document.getElementById('jobsContainer');
            
            if (!jobs || jobs.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="emoji">📭</div>
                        <p>No active jobs. Create your first job above!</p>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = jobs.map(job => {
                const statusClass = `status-${job.status}`;
                const progress = job.total_attempted > 0 
                    ? Math.round((job.total_success / job.total_attempted) * 100) 
                    : 0;
                
                return `
                    <div class="job-card">
                        <div class="job-header">
                            <span class="job-id">#${job.job_id}</span>
                            <span class="job-status ${statusClass}">${job.status}</span>
                        </div>
                        
                        <div style="margin-bottom: 10px;">
                            <strong>Target:</strong> ${escapeHtml(job.target)}<br>
                            <strong>Type:</strong> ${job.target_type}<br>
                            ${job.guild_name ? `<strong>Guild:</strong> ${escapeHtml(job.guild_name)}<br>` : ''}
                            <strong>NPCs:</strong> ${job.npc_count}
                        </div>
                        
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: ${progress}%"></div>
                        </div>
                        <div style="text-align: center; font-size: 0.85rem; color: #888; margin-bottom: 10px;">
                            ${progress}% Complete
                        </div>
                        
                        <div class="job-stats">
                            <div class="stat-box stat-total">
                                <div class="stat-value">${job.total_attempted}</div>
                                <div class="stat-label">Attempted</div>
                            </div>
                            <div class="stat-box stat-success">
                                <div class="stat-value">${job.total_success}</div>
                                <div class="stat-label">Success</div>
                            </div>
                            <div class="stat-box stat-failed">
                                <div class="stat-value">${job.total_failed}</div>
                                <div class="stat-label">Failed</div>
                            </div>
                        </div>
                        
                        <div class="quick-actions" style="margin-top: 15px;">
                            <button class="btn btn-sm btn-primary" onclick="viewLogs('${job.job_id}')">
                                📋 View Logs
                            </button>
                            ${job.status === 'running' ? `
                                <button class="btn btn-sm btn-danger" onclick="cancelJob('${job.job_id}')">
                                    ⛔ Cancel
                                </button>
                            ` : ''}
                        </div>
                    </div>
                `;
            }).join('');
            
            currentJobs = {};
            jobs.forEach(job => {
                currentJobs[job.job_id] = job;
            });
        }
        
        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
        
        function viewLogs(jobId) {
            const job = currentJobs[jobId];
            if (!job) return;
            
            const modalLogs = document.getElementById('modalLogs');
            modalLogs.innerHTML = job.logs.map(log => {
                let logClass = '';
                if (log.includes('failed') || log.includes('error') || log.includes('Failed')) {
                    logClass = 'error';
                } else if (log.includes('success') || log.includes('joined') || log.includes('completed')) {
                    logClass = 'success';
                } else if (log.includes('rate limit') || log.includes('captcha')) {
                    logClass = 'warning';
                }
                return `<div class="log-entry ${logClass}">${escapeHtml(log)}</div>`;
            }).join('');
            
            document.getElementById('logModal').classList.add('active');
        }
        
        function closeLogModal() {
            document.getElementById('logModal').classList.remove('active');
        }
        
        async function cancelJob(jobId) {
            if (!confirm('Are you sure you want to cancel this job?')) return;
            
            try {
                const response = await fetch(`/api/jobs/${jobId}/cancel`, {
                    method: 'POST'
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    showAlert('Job cancellation requested', 'info');
                    refreshJobs();
                } else {
                    showAlert(data.error || 'Failed to cancel job', 'error');
                }
            } catch (error) {
                showAlert('Network error: ' + error.message, 'error');
            }
        }
        
        function startPolling() {
            if (jobsPollingInterval) return;
            
            jobsPollingInterval = setInterval(() => {
                refreshJobs();
            }, 3000);
        }
        
        function stopPolling() {
            if (jobsPollingInterval) {
                clearInterval(jobsPollingInterval);
                jobsPollingInterval = null;
            }
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            refreshJobs();
            startPolling();
        });
        
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeLogModal();
            }
        });
        
        document.getElementById('logModal').addEventListener('click', (e) => {
            if (e.target === document.getElementById('logModal')) {
                closeLogModal();
            }
        });
    </script>
</body>
</html>
